# Server only — add real values to Vercel, never commit them.
RESEND_API_KEY=
RESEND_FROM_EMAIL=VActives <forms@notifications.vactives.com>
FORM_INBOX=info@vactives.com
TURNSTILE_SECRET_KEY=
# Public Turnstile site key; requires a new build when changed.
VITE_TURNSTILE_SITE_KEY=
# Optional exact additional origins for development/preview. No wildcard.
FORM_ALLOWED_ORIGINS=
# Keep referrals disabled until the client approves privacy/referral terms.
# Set BOTH to true to launch; public flag requires a rebuild.
VITE_ENABLE_REFERRALS=false
ENABLE_REFERRALS=false
